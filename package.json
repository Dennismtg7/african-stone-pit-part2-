{
  "name": "stone-pit",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/game"
  ],
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev --workspace @stonepit/api\" \"npm:dev --workspace @stonepit/web\"",
    "build": "npm run build --workspace @stonepit/web",
    "test": "npm test --workspace @stonepit/game && npm test --workspace @stonepit/api",
    "check": "npm run build && npm test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=20"
  }
}
