PORT=3001
WEB_ORIGIN=http://localhost:5173
FIREBASE_PROJECT_ID=mtg7-geoengineer
# Use either GOOGLE_APPLICATION_CREDENTIALS pointing to a service-account JSON file
# or FIREBASE_SERVICE_ACCOUNT containing the JSON. Never expose these to the frontend.
GOOGLE_APPLICATION_CREDENTIALS=
FIREBASE_SERVICE_ACCOUNT=
# Set FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 to use the local Firestore emulator.
FIRESTORE_EMULATOR_HOST=
# Set FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099 for the local Auth emulator.
FIREBASE_AUTH_EMULATOR_HOST=

# Optional IntaSend sandbox/production credentials. Never expose the secret key to the browser.
INTASEND_API_URL=https://sandbox.intasend.com
INTASEND_SECRET_KEY=
